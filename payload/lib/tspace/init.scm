;; tspace/init.scm: amk-tspace for s7, the tuple space of init.amk, with predicates as formals, a tuple as a list, a json array as a vector, an object as a hash table, and null as the symbol null.

(define (amk-tspace-any x) #t)
(define (amk-tspace-null? x) (eq? x 'null))

(define amk-tspace-formals
  (list (cons amk-tspace-any "?") (cons string? "?str") (cons integer? "?int") (cons float? "?float") (cons real? "?number") (cons boolean? "?bool")
        (cons amk-tspace-null? "?null") (cons vector? "?list") (cons hash-table? "?dict")))

(define (amk-tspace-json x)
  (cond ((eq? x 'null) "null")
        ((boolean? x) (if x "true" "false"))
        ((number? x) (number->string x))
        ((string? x)
         (let ((out (open-output-string)))
           (write-char #\" out)
           (for-each (lambda (c)
                       (case c
                         ((#\") (write-string "\\\"" out))
                         ((#\\) (write-string "\\\\" out))
                         ((#\newline) (write-string "\\n" out))
                         (else (if (char<? c #\space) (write-string (string-append "\\u00" (if (< (char->integer c) 16) "0" "") (number->string (char->integer c) 16)) out) (write-char c out)))))
                     x)
           (write-char #\" out)
           (get-output-string out)))
        ((vector? x) (string-append "[" (apply string-append (let loop ((l (vector->list x)) (sep "")) (if (null? l) () (cons (string-append sep (amk-tspace-json (car l))) (loop (cdr l) ","))))) "]"))
        ((hash-table? x) (string-append "{" (apply string-append (let loop ((l (map values x)) (sep "")) (if (null? l) () (cons (string-append sep (amk-tspace-json (symbol->string* (caar l))) ":" (amk-tspace-json (cdar l))) (loop (cdr l) ","))))) "}"))
        (else (error 'wrong-type-arg "amk-tspace: no json for ~S" x))))

(define (symbol->string* k) (if (symbol? k) (symbol->string k) k))

(define (amk-tspace-parse p)
  (define (skip) (when (and (not (eof-object? (peek-char p))) (char-whitespace? (peek-char p))) (read-char p) (skip)))
  (define (word w v) (do ((i 0 (+ i 1))) ((= i (length w)) v) (read-char p)))
  (define (items close one)
    (read-char p)
    (skip)
    (if (char=? (peek-char p) close)
        (begin (read-char p) ())
        (let loop ((acc (list (one))))
          (skip)
          (if (char=? (read-char p) #\,) (loop (cons (one) acc)) (reverse acc)))))
  (define (str)
    (read-char p)
    (let ((out (open-output-string)))
      (let loop ()
        (let ((c (read-char p)))
          (cond ((char=? c #\") (get-output-string out))
                ((char=? c #\\)
                 (let ((e (read-char p)))
                   (case e
                     ((#\n) (write-char #\newline out))
                     ((#\t) (write-char #\tab out))
                     ((#\r) (write-char #\return out))
                     ((#\b) (write-char #\backspace out))
                     ((#\f) (write-char (integer->char 12) out))
                     ((#\u) (write-char (integer->char (string->number (string (read-char p) (read-char p) (read-char p) (read-char p)) 16)) out))
                     (else (write-char e out))))
                 (loop))
                (else (write-char c out) (loop)))))))
  (skip)
  (let ((c (peek-char p)))
    (cond ((char=? c #\[) (apply vector (items #\] (lambda () (skip) (amk-tspace-parse p)))))
          ((char=? c #\{)
           (let ((h (make-hash-table)))
             (for-each (lambda (kv) (set! (h (car kv)) (cdr kv)))
                       (items #\} (lambda () (skip) (let ((k (str))) (skip) (read-char p) (cons k (amk-tspace-parse p))))))
             h))
          ((char=? c #\") (str))
          ((char=? c #\t) (word "true" #t))
          ((char=? c #\f) (word "false" #f))
          ((char=? c #\n) (word "null" 'null))
          (else
           (let ((out (open-output-string)))
             (let loop ()
               (let ((d (peek-char p)))
                 (when (and (not (eof-object? d)) (char-position d "+-.eE0123456789"))
                   (write-char (read-char p) out)
                   (loop))))
             (string->number (get-output-string out)))))))

(define (amk-tspace-call space verb fields)
  (let ((text (apply amk-call (string-append space "." verb)
                     (map (lambda (f) (let ((formal (assq f amk-tspace-formals))) (if formal (cdr formal) (amk-tspace-json f)))) fields))))
    (let loop ((start 0) (acc ()))
      (let ((end (or (char-position #\newline text start) (length text))))
        (if (>= start (length text))
            (reverse acc)
            (loop (+ end 1)
                  (if (= end start) acc (cons (vector->list ((amk-tspace-parse (open-input-string (substring text start end))) "t")) acc))))))))

;; One space by its workspace name, made in make by tspace.create, as a procedure of a verb symbol and its fields.
(define (amk-tspace-on space)
  (lambda (verb . fields)
    (case verb
      ((out) (amk-tspace-call space "out" fields) #t)
      ((read) (amk-tspace-call space "read" fields))
      ((inp) (let ((found (amk-tspace-call space "inp" fields))) (and (pair? found) (car found))))
      ((in) (car (amk-tspace-call space "in" fields)))
      ((rd) (car (amk-tspace-call space "rd" fields)))
      ((no) (amk-tspace-call space "no" fields) #t)
      ((rdp urdp uinp urd uin) (let ((found (amk-tspace-call space (symbol->string verb) fields))) (and (pair? found) (car found))))
      ((nop) (catch #t (lambda () (amk-tspace-call space "nop" fields) #t) (lambda args #f)))
      ((all in_all) (amk-tspace-call space (symbol->string verb) fields))
      ((set out_all out_s) (amk-tspace-call space (symbol->string verb) fields) #t)
      ((rd_s) (amk-tspace-call space "rd_s" fields))
      ((in_s) (let ((found (amk-tspace-call space "in_s" fields))) (and (pair? found) (car found))))
      (else (error 'wrong-type-arg "amk-tspace: no verb ~S" verb)))))

;; A routed field arrives as text; each type word reads it back as s7's own value.
(define (amk-tspace-read-as type v)
  (cond ((member type '("int" "float" "number") string=?) (string->number v))
        ((string=? type "bool") (string=? v "1"))
        ((string=? type "null") 'null)
        ((member type '("list" "dict" "table") string=?) (amk-tspace-parse (open-input-string v)))
        (else v)))

(define (amk-tspace-words s)
  (let loop ((i 0) (start #f) (acc ()))
    (cond ((= i (length s)) (reverse (if start (cons (substring s start i) acc) acc)))
          ((char-whitespace? (s i)) (loop (+ i 1) #f (if start (cons (substring s start i) acc) acc)))
          (else (loop (+ i 1) (or start i) acc)))))

;; The define name as a make function: its body compiled with the space and the named fields as parameters.
(define (amk-tspace-bind space name spec)
  (let* ((fields (map (lambda (w) (let ((at (char-position #\: w))) (cons (substring w 0 at) (substring w (+ at 1)))))
                      (amk-tspace-words spec)))
         (params (apply string-append (map (lambda (f) (if (string=? (car f) "-") "" (string-append " " (car f)))) fields)))
         (body (eval-string (string-append "(lambda (" space params ") " ((amk-var 'raw) name) "\n)"))))
    (amk-func (string->symbol name)
              (lambda args
                (apply body (amk-tspace-on space)
                       (let loop ((f fields) (a args) (acc ()))
                         (cond ((null? f) (reverse acc))
                               ((string=? (caar f) "-") (loop (cdr f) (cdr a) acc))
                               (else (loop (cdr f) (cdr a) (cons (amk-tspace-read-as (cdar f) (car a)) acc))))))
                ""))
    #t))

;; The verbs are make functions, so a makefile that never loaded the space fails here rather than at the first verb.
(when (string=? (amk-call "origin" "tspace.spaces") "undefined")
  (error 'io-error "amk.tspace: the makefile has no tuple space; add load tspace"))

(define (amk-tspace-out . fields) (apply (amk-tspace-on "tuplespace") 'out fields))
(define (amk-tspace-read . pattern) (apply (amk-tspace-on "tuplespace") 'read pattern))
(define (amk-tspace-inp . pattern) (apply (amk-tspace-on "tuplespace") 'inp pattern))
(define (amk-tspace-in . pattern) (apply (amk-tspace-on "tuplespace") 'in pattern))
(define (amk-tspace-rd . pattern) (apply (amk-tspace-on "tuplespace") 'rd pattern))
(define (amk-tspace-no . pattern) (apply (amk-tspace-on "tuplespace") 'no pattern))
