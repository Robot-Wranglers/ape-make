#
# payload/lib/dsys/locks.amk:
#  locks and channels made of pools: amk.mutex, amk.horcrux and
#  amk.rendezvous, each a factory idempotent by name whose verbs reach
#  every guest as fields. load dsys/locks brings them alone, with no
#  engine needed. pool._ is private.
#

# A lock's verbs as functions of its name, amk.<lock>.<name>.<verb>
pool._verbs = $(foreach v,$(3), \
  $(amk.fxn! amk.$(1).$(2).$(v), pool._$(1), $(2), $(v)))
$(amk.fxn! pool._verbs)

# A mutex: a pool of one. lock waits, trylock answers at once, unlock gives back
pool._mutex = $(strip \
  $(if $(filter lock,$(2)),$(amk.pool.acquire $(1))) \
  $(if $(filter trylock,$(2)),$(amk.pool.acquire $(1), 0)) \
  $(if $(filter unlock,$(2)),$(amk.pool.release $(1))))
amk.mutex = $(if $(amk.pool $(1)),,$(strip \
  $(amk.pool $(1), 1) \
  $(pool._verbs mutex, $(1), lock unlock trylock)))
$(amk.fxn! pool._mutex)
$(amk.fxn! amk.mutex)

# A horcrux: a reader takes one piece, a writer every piece behind its own mutex
pool._drain = $(if $(filter $(amk.pool.size $(1)),$(amk.pool.held $(1))),, \
  $(if $(amk.pool.acquire $(1)),)$(call pool._drain,$(1)))
pool._undrain = $(if $(filter 0,$(amk.pool.held $(1))),, \
  $(amk.pool.release $(1))$(call pool._undrain,$(1)))
pool._horcrux = $(strip \
  $(if $(filter rlock,$(2)),$(amk.pool.acquire $(1))) \
  $(if $(filter tryrlock,$(2)),$(amk.pool.acquire $(1), 0)) \
  $(if $(filter runlock,$(2)),$(amk.pool.release $(1))) \
  $(if $(filter wlock,$(2)), \
    $(if $(amk.pool.acquire $(1).w)$(call pool._drain,$(1)),1)) \
  $(if $(filter wunlock,$(2)), \
    $(call pool._undrain,$(1))$(amk.pool.release $(1).w)))
amk.horcrux = $(if $(amk.pool $(1)),,$(strip \
  $(amk.pool $(1), $(2))$(amk.pool $(1).w, 1) \
  $(pool._verbs horcrux, $(1), rlock tryrlock runlock wlock wunlock)))
$(amk.fxn! pool._horcrux)
$(amk.fxn! amk.horcrux)

# A rendezvous: the value in name, its receipt in name.ack, one sender at a time
pool._rendezvous = $(strip \
  $(if $(filter send,$(2)), \
    $(if $(amk.pool.acquire $(1).s)$(amk.pool.produce $(1), $(3)),) \
    $(if $(amk.pool.consume $(1).ack),)$(amk.pool.release $(1).s)) \
  $(if $(filter recv,$(2)), \
    $(let v,$(amk.pool.consume $(1)),$(v)$(amk.pool.produce $(1).ack))))
amk.rendezvous = $(if $(amk.pool $(1)),,$(strip \
  $(amk.pool $(1), labeled=true, strategy=open) \
  $(amk.pool $(1).ack, size=0, strategy=open)$(amk.pool $(1).s, 1) \
  $(pool._verbs rendezvous, $(1), send recv)))
$(amk.fxn! pool._rendezvous)
$(amk.fxn! amk.rendezvous)
