#
# payload/lib/dsys/workflow.amk:
#  workflows: a task graph as JSON under @workflow.dag, compiled by workflow.jq
#  to a net that dsys/petri runs. <name>.net reads the compiled net.
#
workflow._lib := $(patsubst %/,%,$(dir $(lastword $(MAKEFILE_LIST))))
$(amk.require jq)
load dsys/petri

workflow._main := include "workflow"; compile
workflow.__schema__ := dsys/schema/workflow.json
workflow.dag.__schema__ := $(workflow.__schema__)

# The source, a workspace beside the net, compiled to the net's JSON.
workflow.compile = $(jq.argv -c -L $(workflow._lib),$(workflow._main), \
  $(jq.ns $(1).workflow, get, -c .))
$(amk.fxn! workflow.compile)

# @workflow.dag, its import, a .workflow file: the source kept, the net loaded.
workflow.from = $(jq.import $(1).workflow, $(2)) \
  $(eval $(1).source := $(1).workflow) \
  $(call petri.load,$(1),$(workflow.compile $(1)),workflow) \
  $(amk.fxn! $(1).net, petri._q, $(1), -c .)
workflow.at = $(call workflow.from,$(1),$(amk.val.json5 $(2)))
workflow.dag_star = $(call workflow.at,$(call petri.named,$(1),workflow),$(1))
workflow.dag.import_star = $(call workflow.dag_star,$(1))
workflow.dag.target_star = $(call workflow.dag_star,$(1)) \
  $(call petri.target,$(call petri.named,$(1),workflow))
workflow.dag.exec_star = $(call petri.exec_star,$(1),$(2),workflow.dag)
$(amk.fxn! workflow.dag.exec, petri.exec)

# The data variety: a workflow from text or empty, its version, and a wait.
workflow.empty := {"tasks":{}}
workflow.dag.create = $(call workflow.from,$(1), \
  $(if $(filter undefined,$(origin 2)),$(workflow.empty),$(2)))
$(amk.fxn! workflow.dag.create)
$(amk.fxn! workflow.dag.version, petri.version)
$(amk.fxn! workflow.dag.wait, petri.wait)
$(amk.engine workflow.dag, guest=jq, aliases=workflow)
