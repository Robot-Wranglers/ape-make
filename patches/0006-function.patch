+/* One handle, ns.op, or its star twin.  */
+void
+amk_handle_add (const char *ns, const char *op, size_t oplen, int star)
+{
+  struct function_table_entry *f = xcalloc (sizeof *f);
+  char *name = xmalloc (strlen (ns) + oplen + 3);
+  sprintf (name, "%s.%.*s%s", ns, (int) oplen, op, star ? "*" : "");
+  f->fptr.func_ptr = star ? func_star : func_handle;
+  f->name = name;
+  f->len = strlen (name);
+  f->minimum_args = 1;
+  f->maximum_args = 1;
+  f->expand_args = 1;
+  hash_insert (&function_table, f);
+  if (star)
+    amk_star_macro (name, 1);
+}
