+/* The engine builtins join the table from the engine rows, so a row is the whole registration.  */
+static struct function_table_entry amk_function_entries[512];
+
+/* One engine builtin into its slot and the table, answering the slot after it.  */
+static struct function_table_entry *
+amk_entry_add (struct function_table_entry *f, const char *name, char *(*fn) (char *, char **, const char *),
+               unsigned char min, unsigned char max)
+{
+  f->fptr.func_ptr = fn;
+  f->name = name;
+  f->len = strlen (name);
+  f->minimum_args = min;
+  f->maximum_args = max;
