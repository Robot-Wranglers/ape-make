+/* The argument count of the innermost user function being expanded, its name included, zero outside any; the pending count is taken before a nested call pads its caller's extra numbers.  */
+static unsigned int amk_call_args;
+static unsigned int amk_call_pending;
+
+/* The bridge to that count for amk.args, its name left out.  */
+unsigned int
+amk_call_argc (void)
+{
+  return amk_call_args > 0 ? amk_call_args - 1 : 0;
+}

+/* One star argument: the dedented unexpanded value of the variable it names, or null when it names none and passes as written.  */
+static char *
+star_arg (const char *funcname, const char *arg, char **namep)
+{
+  const char *start = arg;
+  const char *end = arg + strlen (arg);
+  struct variable *v;
+  char *name, *text;
+  size_t width;
+  int bad;
+
+  while (ISSPACE (*start))
+    start++;
+  while (end > start && ISSPACE (end[-1]))
+    end--;
+  if (end == start)
+    return NULL;
+  v = lookup_variable (start, end - start);
+  if (v == NULL)
+    return NULL;
+  name = xstrndup (start, end - start);
+  text = amk_dedent (v->value, &width, &bad);
+  if (bad)
+    fatal (reading_file, strlen (funcname) + strlen (name) + INTSTR_LENGTH, _("%s %s: inconsistent indentation (a line is less-indented than the %d-column body base)"), funcname, name, (int) width);
+  if (namep)
+    *namep = name;
+  else
+    free (name);
+  return text;
+}
+
+/* A star builtin: the builtin named without the star, each argument that names a variable replaced by that variable's value and any other passed as written.  */
+static char *
+func_star (char *o, char **argv, const char *funcname)
+{
+  char *base = xstrndup (funcname, strlen (funcname) - 1);
+  const struct function_table_entry *f = lookup_function (base);
+  char *args[4], *held[4], *name = NULL;
+  int i, n;
+
+  for (n = 0; n < 3 && argv[n] != NULL; ++n)
+    held[n] = NULL;
+  /* An import target or a workspace import named by a variable takes that name and that body; an import target's flags after it pass as written.  */
+  if (((n <= 2 && strlen (base) > 7 && strcmp (base + strlen (base) - 7, ".target") == 0)
+       || (n == 1 && amk_is_workspace_import (base)))
+      && (held[0] = star_arg (funcname, argv[0], &name)) != NULL)
+    {
+      args[0] = name;
+      args[1] = held[0];
+      args[2] = n == 2 ? argv[1] : NULL;
+      args[3] = NULL;
+    }
+  else if (n == 1 && amk_is_workspace_import (base))
+    OSS (fatal, reading_file, _("%s: %s names no variable"), funcname, amk_trim (argv[0]));
+  else
+    {
+      /* A namespace call's name and operation pass as written, as does a workspace import's name; only the text after them may name a variable.  */
+      int from = strlen (base) > 3 && strcmp (base + strlen (base) - 3, ".ns") == 0 ? (n == 3 ? 2 : n)
+                 : amk_is_workspace_import (base) ? 1 : 0;
+      for (i = 0; i < n; ++i)
+        {
+          held[i] = i >= from ? star_arg (funcname, argv[i], NULL) : NULL;
+          args[i] = held[i] ? held[i] : argv[i];
+        }
+      args[n] = NULL;
+    }
+  o = f->fptr.func_ptr (o, args, f->name);
+  for (i = 0; i < n; ++i)
+    free (held[i]);
+  free (name);
+  free (base);
+  return o;
+}
