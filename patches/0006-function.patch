+/* An engine builtin's name: a spelling of the engine, a dot, and a suffix.  */
+static char *
+amk_entry_name (const char *spelling, const char *suffix, size_t len)
+{
+  char *name = xmalloc (strlen (spelling) + len + 2);
+  sprintf (name, "%s.%.*s", spelling, (int) len, suffix);
+  return name;
+}
+
+/* Every builtin of one engine under one spelling, its name or an alias: each operation's name, .ns, and .import answer through the interface the row has, or refuse; an operation in main takes one argument, so its program keeps its commas.  */
+static struct function_table_entry *
+amk_engine_entries (struct function_table_entry *f, const struct amk_engine *e, const char *spelling)
+{
+  const char *p = AMK_OPS_ALL, *w;
+  size_t wlen;
+  f = amk_entry_add (f, spelling, func_engine, 1, 2);
+  if (e->cli->argv)
+    f = amk_entry_add (f, amk_entry_name (spelling, "argv", 4), func_engine, 2, 3);
+  while ((w = find_next_token (&p, &wlen)) != NULL)
+    if (wlen != 6 || memcmp (w, "import", 6) != 0)
+      f = amk_entry_add (f, amk_entry_name (spelling, w, wlen), amk_engine_has_op (e, w, wlen) ? func_op : func_refuse, 1, 1);
+  f = amk_entry_add (f, amk_entry_name (spelling, "ns", 2), amk_engine_kept (e) != NULL ? func_ns : func_refuse, 2, 3);
+  f = amk_entry_add (f, amk_entry_name (spelling, "ns.create", 9), amk_engine_kept (e) != NULL ? func_ns_create : func_refuse, 1, 2);
+  f = amk_entry_add (f, amk_entry_name (spelling, "import.target", 13), func_import_target, 1, 3);
+  f = amk_entry_add (f, amk_entry_name (spelling, "target", 6), func_import_target, 1, 3);
+  /* A state's import lifts the guest's names into make; a workspace's makes a namespace from a name and its whole value, so the at line above a define gives that define's name a workspace.  */
+  f = amk_entry_add (f, amk_entry_name (spelling, "import", 6),
+                     e->state != NULL ? func_op : e->workspace != NULL ? func_workspace_import : func_refuse,
+                     1, e->state != NULL ? 1 : 2);
+  return f;
+}
+
+static void
+amk_load_engine_functions (void)
+{
+  const struct amk_engine *e;
+  struct function_table_entry *f = amk_function_entries;
+  amk_engines_check ();
+  for (e = amk_engines; e->name; ++e)
+    {
+      const char *p = e->aliases;
+      f = amk_engine_entries (f, e, e->name);
+      while (p != NULL && *p)
+        {
+          size_t n = strcspn (p, " ");
+          f = amk_engine_entries (f, e, xstrndup (p, n));
+          p += n;
+          while (*p == ' ')
+            ++p;
+        }
+    }
+  /* Every builtin gets a star twin whose arguments may name variables.  */
+  {
+    struct function_table_entry *end = f, *g;
+    for (g = amk_function_entries; g < end; ++g)
+      {
+        char *name = xmalloc (g->len + 2);
+        sprintf (name, "%s*", g->name);
+        f->fptr.func_ptr = func_star;
+        f->name = name;
+        f->len = g->len + 1;
+        f->minimum_args = 1;
+        f->maximum_args = g->maximum_args;
+        f->expand_args = 1;
+        hash_insert (&function_table, f++);
+      }
+  }
+}
+
+/* Every star builtin in the table gets its twin macro once the table is whole.  */
+static void
+amk_star_macro_entry (const void *item, void *arg)
+{
+  const struct function_table_entry *f = item;
+  (void) arg;
+  if (f->len > 1 && f->name[f->len - 1] == '*')
+    amk_star_macro (f->name, f->maximum_args);
+}
