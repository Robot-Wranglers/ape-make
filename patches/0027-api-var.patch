+
+/* Whether a make function of that name exists, builtin or added, so a guest can refuse to replace one: the table's insert would free the old entry, and a builtin's is static.  */
+int
+amk_function_exists (const char *name)
+{
+  return lookup_function (name) != NULL;
+}
+
+/* Inside a forked guest, the queue file every write goes to as a record; anywhere else, none, and a write applies at once.  */
+int amk_queue_fd = -1;
+
+/* Whether make has built its variable tables: not yet under an engine flag, where the guest runs before any makefile.  */
+int
+amk_has_db (void)
+{
+  return current_variable_set_list != NULL && current_variable_set_list->set->table.ht_vec != NULL;
+}
+
+/* The value a guest reads through its variable proxy: expanded the way a reference would be, and null rather than empty for a name make has never seen.  */
+char *
+amk_var_get (const char *name)
+{
+  struct variable *v;
+  if (!amk_has_db ())
+    return NULL;
+  v = lookup_variable (name, strlen (name));
+  if (v == NULL)
+    return NULL;
+  return recursively_expand (v);
+}
+
+static void
+amk_queue_write (int fd, const char *s, size_t n)
+{
+  while (n > 0)
+    {
+      ssize_t w = write (fd, s, n);
+      if (w < 0 && errno == EINTR)
+        continue;
+      if (w <= 0)
+        return;
+      s += w;
+      n -= w;
+    }
+}
+
+/* One record: the kind, the two lengths, then the two bodies back to back.  */
+static void
+amk_queue_record (char kind, const char *a, const char *b)
+{
+  char head[64];
+  size_t la = strlen (a);
+  size_t lb = b ? strlen (b) : 0;
+  int n = snprintf (head, sizeof head, "%c %lu %lu\n", kind, (unsigned long) la, (unsigned long) lb);
+  amk_queue_write (amk_queue_fd, head, (size_t) n);
+  amk_queue_write (amk_queue_fd, a, la);
+  if (lb > 0)
+    amk_queue_write (amk_queue_fd, b, lb);
+}
+
+/* A simple variable with the literal value, at file origin so an override still wins; queued from a forked guest.  */
+void
+amk_var_set (const char *name, const char *value)
+{
+  if (amk_queue_fd >= 0)
+    {
+      amk_queue_record ('V', name, value);
+      return;
+    }
+  if (!amk_has_db ())
+    return;
+  define_variable_global (name, strlen (name), value, o_file, 0, NILF);
+}
+
+/* Text read as makefile syntax; queued from a forked guest.  */
+void
+amk_eval (const char *text)
+{
+  if (amk_queue_fd >= 0)
+    {
+      amk_queue_record ('E', text, NULL);
+      return;
+    }
+  if (!amk_has_db ())
+    return;
+  gmk_eval (text, NULL);
+}
+
+/* The parent's side of the queue: every record the child left, applied in order, then the file goes.  */
+void
+amk_queue_apply (FILE *queue)
+{
+  char *buf;
+  size_t len = 0, cap = 4096, pos = 0;
+  int fd;
+
+  if (queue == NULL)
+    return;
+  fd = fileno (queue);
+  lseek (fd, 0, SEEK_SET);
+  buf = xmalloc (cap + 1);
+  while (1)
+    {
+      ssize_t r;
+      if (len == cap)
+        {
+          cap += 4096;
+          buf = xrealloc (buf, cap + 1);
+        }
+      r = read (fd, buf + len, cap - len);
+      if (r < 0 && errno == EINTR)
+        continue;
+      if (r <= 0)
+        break;
+      len += r;
+    }
+  fclose (queue);
+  while (pos < len)
+    {
+      char kind;
+      unsigned long la, lb;
+      int used = 0;
+      char *a, *b;
+      if (sscanf (buf + pos, "%c %lu %lu\n%n", &kind, &la, &lb, &used) < 3 || used == 0)
+        break;
+      pos += (size_t) used;
+      if (pos + la + lb > len)
+        break;
+      a = xstrndup (buf + pos, la);
+      b = xstrndup (buf + pos + la, lb);
+      pos += la + lb;
+      if (kind == 'V')
+        amk_var_set (a, b);
+      else if (kind == 'E')
+        amk_eval (a);
+      free (a);
+      free (b);
+    }
+  free (buf);
+}
