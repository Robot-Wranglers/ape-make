Sink: an engine's persist entry writes its result to a sink the make side passes in,
rather than to a stdio stream. A persistent call's sink appends straight into the
expansion make is building, at the call's place, so a result costs no temp file, no
read-back and no copy, and has no size limit; the trailing newline every builtin drops
comes off by stepping back in that buffer. The init chunk's sink is stderr. The guest
declares the one-field struct itself and keeps no header of make's.

--- a/src/function.c
+++ b/src/function.c
@@ -2602,7 +2602,7 @@
         av[0] = (char *) e->name;
         av[1] = chunk;
         av[2] = NULL;
-        e->persist (stderr, 2, av);
+        e->persist (&amk_sink_stderr, 2, av);
         free (chunk);
       }
 }
@@ -2801,16 +2801,39 @@
   return o;
 }
 
+/* The expansion being built, as a sink: what an engine writes lands in make's own buffer at the call's place, with no copy between.  */
+extern char *variable_buffer;
+
+struct amk_expand_sink
+  {
+    struct amk_sink base;
+    char *o;
+  };
+
+static void
+amk_expand_write (struct amk_sink *s, const char *p, size_t n)
+{
+  struct amk_expand_sink *e = (struct amk_expand_sink *) s;
+  e->o = variable_buffer_output (e->o, p, n);
+}
+
+static void
+amk_stderr_write (struct amk_sink *s, const char *p, size_t n)
+{
+  (void) s;
+  fwrite (p, 1, n, stderr);
+}
+
+struct amk_sink amk_sink_stderr = { amk_stderr_write };
+
 /* $(name.exec program[,input]): the row's persist entry in this process, no fork, so what one call leaves in the engine's state the next call finds. */
 static char *
 func_persistent (char *o, char **argv, const char *funcname)
 {
   const struct amk_engine *e = amk_engine_by_name (funcname);
+  struct amk_expand_sink sink;
   char *av[4];
-  char *buffer;
-  size_t len;
-  long end;
-  FILE *out;
+  size_t start = o - variable_buffer;
   int ac = 2;
   int rc;
 
@@ -2820,29 +2843,19 @@
