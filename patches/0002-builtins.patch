+/* The engine builtins join the table from the engine rows, so a row is the whole registration.  */
+static struct function_table_entry amk_function_entries[64];
+
+static void
+amk_load_engine_functions (void)
+{
+  const struct amk_engine *e;
+  struct function_table_entry *f = amk_function_entries;
+  for (e = amk_engines; e->name; ++e)
+    {
+      f->fptr.func_ptr = func_engine;
+      f->name = e->name;
+      f->len = strlen (e->name);
+      f->minimum_args = 1;
+      f->maximum_args = 2;
+      f->expand_args = 1;
+      hash_insert (&function_table, f++);
+      if (e->argv)
+        {
+          char *name = xmalloc (f[-1].len + 6);
+          sprintf (name, "%s.argv", e->name);
+          *f = f[-1];
+          f->name = name;
+          f->len += 5;
+          f->minimum_args = 2;
+          f->maximum_args = 3;
+          hash_insert (&function_table, f++);
+        }
+    }
+}
+
