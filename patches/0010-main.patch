+      char mail[16];
+
+      amk_mail_fd = fds[AMK_MAILFD];
+      sprintf (mail, "%d", amk_mail_fd);
+      define_variable_global ("AMK_MAIL", 8, mail, o_env, 0, NILF)->export = v_export;
+    } else if (fds[AMK_MAILFD] > STDERR_FILENO)
+      close (fds[AMK_MAILFD]);
+
+    /* The caller's call pair arrived the same way: with it this process forwards every workspace call up it, without it the slots are closed and it owns a workspace.  */
+    if (amk_env_value (p, envc, "AMK_CALL") != 0 && amk_env_value (p, envc, "AMK_REPLY") != 0)
+      amk_call_dispatch (fds[AMK_CALLFD], fds[AMK_REPLYFD]);
+    else {
+      if (fds[AMK_CALLFD] > STDERR_FILENO)
+        close (fds[AMK_CALLFD]);
+      if (fds[AMK_REPLYFD] > STDERR_FILENO)
+        close (fds[AMK_REPLYFD]);
+      amk_call_dispatch (-1, -1);
+    }
+
+    /* A name whose value is this process rather than the caller's: only the
+       child knows it, so it is set here rather than promoted from the request.  */
+    if (aspid != 0)
+      amk_rearm_pid (aspid);
+    free (rearm);
+    free (aspid);
+  }
+
+  p = argp;
+  for (i = 0; i < argc; ++i) {
+    /* Options were matched against the zygote's own, so they are no-ops here.  */
+    if (p[0] == '-' && p[1] != '\0') {
+      if (amk_opt_takes_arg (p) && i + 1 < argc) { p += strlen (p) + 1; ++i; }
+      p += strlen (p) + 1;
+      continue;
+    }
+    handle_non_switch_argument (p, o_command);
+    p += strlen (p) + 1;
+  }
+
+  /* A request naming no goal means the default, which the zygote resolved for its
+     own argv before the fork and this child discarded along with the rest.  */
+  if (goals == 0 && default_goal_var != 0)
+    amk_default_goal_settle ();
+  if (goals == 0 && default_goal_var != 0 && default_goal_var->value[0] != '\0') {
+    char *dg = allocated_variable_expand (default_goal_var->value);
+
+    if (dg != 0 && dg[0] != '\0')
+      handle_non_switch_argument (dg, o_command);
+    free (dg);
+  }
+
+  amk_child_ready ();
+
+  /* A makefile may record its own command line by reading the parent process,
+     which under dispatch is the zygote rather than the caller.  Rebuild it from
+     the request, at an origin that outranks the parse-time assignment.  */
+  {
+    size_t need = strlen (amk_serve_argv[0]) + 1;
+    const char *q = argp;
+    char *cli, *w;
+
+    for (i = 0; i < argc; ++i) { need += strlen (q) + 1; q += strlen (q) + 1; }
+
+    cli = xmalloc (need);
+    w = cli + sprintf (cli, "%s", amk_serve_argv[0]);
+    q = argp;
+    for (i = 0; i < argc; ++i) { w += sprintf (w, " %s", q); q += strlen (q) + 1; }
+    define_variable_cname ("MAKE_CLI", cli, o_override, 0)->export = v_export;
+    free (cli);
+  }
+
+  die (amk_child_run ());
+}
+
+/* The words become the goal list and run, as a served request's do; the result is make's exit status.  */
+int
+amk_run_goals (int n, char **words) {
+  int i;
+  amk_child_goals_reset ();
+  for (i = 0; i < n; ++i)
+    handle_non_switch_argument (words[i], o_command);
+  /* A job spawned while a recipe expands collected its goals in that target's
+     variable set; every target of the job reads them from the global one.  */
+  {
+    struct variable *gv = lookup_variable (STRING_SIZE_TUPLE ("MAKECMDGOALS"));
+    define_variable_global ("MAKECMDGOALS", 12, gv != 0 ? gv->value : "", o_default, 0, NILF);
+  }
+  amk_child_ready ();
+  return amk_child_run ();
+}
