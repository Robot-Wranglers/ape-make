+/* The names AMK_REARM_PID lists take this process's pid, in the global set so
+   every target of a child forked while a recipe expands reads its own.  */
+void
+amk_rearm_pid (const char *names) {
+  char pid[32];
+  const char *q = names;
+
+  sprintf (pid, "%d", (int) getpid ());
+  while (*q != '\0') {
+    size_t n;
+
+    q += strspn (q, " \t");
+    n = strcspn (q, " \t");
+    if (n == 0)
+      break;
+    define_variable_global (q, n, pid, o_override, 0, NILF);
+    q += n;
+  }
