+        }
+      args[n] = NULL;
+    }
   o = f->fptr.func_ptr (o, args, f->name);
-  free (text);
+  for (i = 0; i < n; ++i)
+    free (held[i]);
+  free (name);
   free (base);
   return o;
 }
