s7 joins the persistent family: its row gains the persist and hook entries, so
$(s7.exec ...), $(s7.import ...), the AMK_S7_INIT chunk, and amk-on hooks all run
against one interpreter kept for the life of the make process, as the other rows' do.

--- a/src/function.c
+++ b/src/function.c
@@ -2505,3 +2505,3 @@
 #ifdef AMK_ENGINE_S7
-    { "s7", 0, s7_run_main, 0, 0, 0 },
+    { "s7", 0, s7_run_main, 0, 0, 0, s7_persist_main, s7_hook_main },
 #endif
