sqlite: a workspace row whose state is an in-memory database. A request is one or more
statements; get and update print each row as a JSON object on a line, load replaces the
database with the text's statements, and the whole program is the dump of schema and
rows that load replays. The guest is guest/sqlite_main.c over the amalgamation, and the
sqlite3 name is sqlite's own shell; the row passes -- ahead of a program, so a target or
a builtin runs it against an in-memory database unless its flags name one.

--- a/src/function.c
+++ b/src/function.c
@@ -2516,6 +2516,9 @@
 #ifdef AMK_ENGINE_QUICKJS
     { "js", 0, js_run_main, 0, 0, 0, js_open, js_run, js_hook, 0, "exec import" },
 #endif
+#ifdef AMK_ENGINE_SQLITE
+    { "sqlite", "sqlite3", sqlite_main, 1, 0, 1, sqlite_open, sqlite_run, 0, 0, "get update load", ".dump" },
+#endif
     { 0, 0, 0, 0, 0, 0 }
   };

--- a/src/main.c
+++ b/src/main.c
@@ -2536,6 +2536,9 @@
 #ifdef AMK_ENGINE_QUICKJS
     define_variable_cname ("js.__version__", AMK_STR(AMK_ENGINE_QUICKJS), o_default, 0);
 #endif
+#ifdef AMK_ENGINE_SQLITE
+    define_variable_cname ("sqlite.__version__", AMK_STR(AMK_ENGINE_SQLITE), o_default, 0);
+#endif
     define_variable_cname ("amk.__fxns__", "$(amk.fxns? $(.ENGINES))", o_default, 1);
     define_variable_cname ("amk.__vars__", "$(amk.vars? $(.ENGINES))", o_default, 1);
     free (all);
