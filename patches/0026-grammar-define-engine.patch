+/* The target behind a define for an engine: phony, named as the variable, with a recipe that hands the body to the engine's builtin and prints what comes back.  */
+static void
+define_engine_target (const struct variable *v, const struct vmodifiers *vmod,
+                      const floc *flocp)
+{
+  static const char shape[] = ".PHONY: %s\n%s:; @$(info $(%s ${%s}))\n";
+  const char *engine;
+  char *text;
+  int no_goal_yet = default_goal_var->value[0] == '\0';
+
+  if (vmod->engine_v == NULL)
+    {
+      char *word = xstrndup (vmod->engine_word, vmod->engine_wlen);
+      OS (fatal, flocp, _("'%s' names no engine in this build"), word);
+    }
+
+  engine = vmod->engine_v->name;
+  text = xmalloc (sizeof shape + 3 * strlen (v->name) + strlen (engine));
+  sprintf (text, shape, v->name, v->name, engine, v->name);
+  eval_buffer (text, flocp);
+  free (text);
+
+  /* A define is not a rule, so it does not take the default goal the way the first rule would.  */
+  if (no_goal_yet)
+    define_variable_global (".DEFAULT_GOAL", 13, "", o_file, 0, NILF);
+}
