+/* The rule behind an imported target, never the default goal: a phony target of the name, with its prerequisites, that records its engine, its program, the flags its engine takes before the program, and the goals its body references. The job launcher runs the program in a fork of make, so the recipe line only names it, and nothing of the value directory is touched here.  */
+void
+amk_import_target (const char *name, const char *engine, const char *body,
+                   const char *flags, const char *prereqs, const floc *flocp)
+{
+  static const char shape[] = ".PHONY: %s\n%s: %s; @: %s %s\n";
+  int no_goal_yet = default_goal_var->value[0] == '\0';
+  const char *deps = prereqs != NULL ? prereqs : "";
+  char *text = xmalloc (sizeof shape + 3 * strlen (name) + strlen (engine) + strlen (deps));
+  struct file *f;
+
+  sprintf (text, shape, name, name, deps, engine, name);
+  eval_buffer (text, flocp);
+  free (text);
+  f = lookup_file (name);
+  if (f == NULL)
+    OS (fatal, flocp, _("%s: the imported target left no rule"), name);
+  f->amk_engine = amk_engine_by_name (engine);
+  f->amk_program = strcache_add (name);
+  f->amk_flags = flags != NULL && *flags != '\0' ? strcache_add (flags) : NULL;
+  f->amk_refs = amk_goal_refs (body);
+
+  if (no_goal_yet)
+    define_variable_global (".DEFAULT_GOAL", 13, "", o_file, 0, NILF);
+}
