One place for a child's goals: a served request and a spawned job each dropped
the goals it inherited, rebuilt MAKEFLAGS and ran its own, in two copies that
had already drifted once. Both now call the same three steps, so what a child
of the parsed image must do before it runs a goal is written once. No behavior
changes.

--- a/src/main.c
+++ b/src/main.c
@@ -5317,13 +5317,41 @@
   }
 }

+/* A child of the parsed image, served or spawned, takes its goals in three
+   steps that are the same for both: it drops the goals it inherited, it is
+   made ready once its own are recorded, and it runs them.  */
+static void
+amk_child_goals_reset (void) {
+  goals = 0;
+  lastgoal = 0;
+  define_variable_cname ("MAKECMDGOALS", "", o_default, 0);
+}
+
+/* MAKEFLAGS was built before the fork, so it is rebuilt for sub-makes.  */
+static void
+amk_child_ready (void) {
+  define_makeflags (0);
+}
+
+static int
+amk_child_run (void) {
+  if (goals == 0)
+    return MAKE_SUCCESS;
+  switch (update_goal_chain (goals)) {
+  case us_none:
+  case us_success:  return MAKE_SUCCESS;
+  case us_question: return MAKE_TROUBLE;
+  case us_failed:   break;
+  }
+  return MAKE_FAILURE;
+}
+
