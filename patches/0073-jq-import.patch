+/* Whether a builtin's name is the store's import.  */
+static int
+amk_is_store_import (const char *name)
+{
+  size_t n = strlen (AMK_STORE_ENGINE);
+  return strncmp (name, AMK_STORE_ENGINE, n) == 0 && streq (name + n, ".import");
+}
+
+/* $(jq.import name,text): the namespace made as create makes it, handles included, with the one JSON text loaded as its value; importing the name again replaces the value.  */
+static char *
+func_store_import (char *o, char **argv, const char *funcname)
+{
+  const struct amk_engine *e = amk_engine_by_name (funcname);
+  struct amk_text_sink sink = { { amk_text_write }, NULL, 0 };
+  char *ns = amk_trim (argv[0]);
+  struct amk_ns *row;
+  int rc;
+
+  if (argv[1] == NULL)
+    OS (fatal, reading_file, _("%s: no text; give a namespace and its JSON, or put the at line above a define"), funcname);
+  if (!amk_ns_valid (ns))
+    OSS (fatal, reading_file, _("%s: namespace \"%s\" is not a name"), funcname, ns);
+  if (amk_call_forwarding ())
+    OS (fatal, reading_file, _("%s: an import's text does not travel the call channel"), funcname);
+  amk_ns_create (e, ns, funcname);
+  row = amk_ns_find (e, ns);
+  rc = amk_ns_apply (e, row, &sink.base, "load", argv[1]);
+  free (sink.buf);
+  if (rc != 0)
+    OSS (fatal, reading_file, _("%s: %s: the text did not load as one JSON value"), funcname, ns);
+  return o;
+}
+
