+/* The next word of a request line into word, p moved past it; 0 at the end.  */
+static int
+amk_call_word (const char **p, char *word, size_t size) {
+  const char *s = *p;
+  size_t n = 0;
+  while (*s == ' ' || *s == '\t')
+    ++s;
+  if (*s == '\0') {
+    *p = s;
+    return 0;
+  }
+  while (*s != '\0' && *s != ' ' && *s != '\t') {
+    if (n + 1 < size)
+      word[n++] = *s;
+    ++s;
+  }
+  word[n] = '\0';
+  *p = s;
+  return 1;
+}
+
+/* The whole of a file as text, or null with the reason on stderr.  */
+static char *
+amk_call_slurp (const char *op, const char *name, const char *path) {
+  FILE *f = fopen (path, "r");
+  char *text;
+  size_t len = 0, cap = 4096;
+  if (f == NULL) {
+    fprintf (stderr, "amk: call: %s %s: cannot read %s\n", op, name, path);
+    return NULL;
+  }
+  text = xmalloc (cap + 1);
+  for (;;) {
+    len += fread (text + len, 1, cap - len, f);
+    if (len < cap)
+      break;
+    cap *= 2;
+    text = xrealloc (text, cap + 1);
+  }
+  text[len] = '\0';
+  fclose (f);
+  return text;
+}
+
+/* One request line to the store: the operation, the name, and the rest as the program. A dump is a get of the whole value, a load names a file read here, and a filter, whose input lines the transport counted, runs with no name.  */
+static int
+amk_call_serve (struct amk_sink *out, const char *line, const char *input) {
+  char op[32], name[1024];
+  const char *p = line;
+  char *text;
+  int rc;
+
+  if (!amk_call_word (&p, op, sizeof op)) {
+    fprintf (stderr, "amk: call: expected an operation, got: %s\n", line);
+    return 2;
+  }
+  if (strcmp (op, "filter") == 0) {
+    if (amk_call_input_lines (line) >= 0)
+      amk_call_word (&p, name, sizeof name);
+    while (*p == ' ' || *p == '\t')
+      ++p;
+    return amk_store_filter (out, p, input);
+  }
+  if (!amk_call_word (&p, name, sizeof name)) {
+    fprintf (stderr, "amk: call: %s: expected a name, got: %s\n", op, line);
+    return 2;
+  }
+  while (*p == ' ' || *p == '\t')
+    ++p;
+  if (strcmp (op, "dump") == 0)
+    return amk_store_call (out, "get", name, ".");
+  if (strcmp (op, "load") == 0) {
+    char path[4096];
+    if (!amk_call_word (&p, path, sizeof path)) {
+      fprintf (stderr, "amk: call: load %s: no path\n", name);
+      return 2;
+    }
+    text = amk_call_slurp (op, name, path);
+    if (text == NULL)
+      return 2;
+    rc = amk_store_call (out, "load", name, text);
+    free (text);
+    return rc;
+  }
+  return amk_store_call (out, op, name, p);
 }

