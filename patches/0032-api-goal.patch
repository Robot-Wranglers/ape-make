+/* $(goal name): the goal's value file brought up to date by a fork of this image, then read; the value directory is expanded here so a makefile may set goal.dir.  */
+char *
+amk_func_goal (char *o, char **argv, const char *funcname)
+{
+  char *dir = allocated_variable_expand ("$(or $(goal.dir),.amk/goals)");
+  char *name = argv[0];
+  char *end, *path, *words[1];
+  pid_t pid, got = 0;
+  int code = 0, sig = 0, stopped = 0;
+  size_t start = o - variable_buffer;
+  FILE *fp;
+  char buf[4096];
+  size_t n;
+
+  while (ISSPACE (*name))
+    name++;
+  end = name + strlen (name);
+  while (end > name && ISSPACE (end[-1]))
+    *--end = '\0';
+  if (*name == '\0')
+    OS (fatal, NILF, _("$(%s ...): no goal named"), funcname);
+  path = xmalloc (strlen (dir) + strlen (name) + 2);
+  sprintf (path, "%s/%s", dir, name);
+  free (dir);
+
+  words[0] = path;
+  pid = amk_spawn_goals (1, words, 0, "/dev/null");
+  if (pid < 0)
+    OSS (fatal, NILF, _("$(%s %s): cannot fork"), funcname, name);
+  do
+    amk_wait_child (pid, 1, &got, &code, &sig, &stopped);
+  while (stopped);
+  if (code != 0 || sig != 0)
+    OSS (fatal, NILF, _("$(%s %s): the goal failed"), funcname, name);
+
+  fp = fopen (path, "r");
+  if (fp == NULL)
+    OSS (fatal, NILF, _("$(%s %s): the goal left no value"), funcname, name);
+  while ((n = fread (buf, 1, sizeof buf, fp)) > 0)
+    o = variable_buffer_output (o, buf, n);
+  fclose (fp);
+  free (path);
+
+  /* One trailing newline goes, as for every builtin; the buffer may have moved, so the start is an offset.  */
+  if ((size_t) (o - variable_buffer) > start && o[-1] == '\n')
+    {
+      --o;
+      if ((size_t) (o - variable_buffer) > start && o[-1] == '\r')
+        --o;
+    }
+  return o;
+}
