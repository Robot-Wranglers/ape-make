+/* The value directory as a makefile spells it, expanded when a rule is read, so a makefile sets goal.dir before its first define.  */
+static const char amk_goal_dir[] = "$(or $(goal.dir),.amk/goals)";
+
+/* Every goal the body references through the goal function, as its value file, space separated and allocated.  */
+static char *
+amk_cell_deps (const char *body)
+{
+  char *deps = xstrdup ("");
+  const char *p = body;
+  while ((p = strstr (p, "goal ")) != NULL)
+    {
+      const char *name;
+      size_t len;
+      int opened = p >= body + 2 && (p[-1] == '(' || p[-1] == '{') && p[-2] == '$';
+      p += 5;
+      if (!opened)
+        continue;
+      while (*p == ' ')
+        p++;
+      name = p;
+      len = strcspn (name, ") }\n");
+      if (len > 0)
+        {
+          size_t have = strlen (deps);
+          deps = xrealloc (deps, have + sizeof amk_goal_dir + len + 3);
+          sprintf (deps + have, " %s/%.*s", amk_goal_dir, (int) len, name);
+        }
+      p = name + len;
+    }
+  return deps;
+}
+
+/* The rules behind a define for an engine: once, the directory and the pattern that copies a plain file into it; then the value file, rebuilt when a value the body reads is newer, and the phony target of the define's name that prints it. The program is expanded while the recipe is, so its value references resolve in this process, and it reaches the engine on the job's standard input, so cells overlap under -j and a program has no size limit.  */
+char *
+amk_cell_text (const char *name, const char *engine, const char *body)
+{
+  static int prepared;
+  static const char preamble[] = "$(shell mkdir -p %s)\n%s/%%: %%; @$(file >$@,$(file <$<))\n";
+  static const char shape[] = ".PHONY: %s\n%s: %s/%s; @$(info $(file <$<))\n%s/%s:%s; @$(job.stdin ${%s})$(MAKE) --%s %s >$@\n";
+  const char *program = strcmp (engine, "awk") == 0 ? "-f -" : strcmp (engine, "jq") == 0 ? "-n -f /dev/stdin" : "-";
+  char *deps = amk_cell_deps (body);
+  size_t len = sizeof preamble + sizeof shape + 4 * sizeof amk_goal_dir + 5 * strlen (name) + strlen (engine) + strlen (deps) + 24;
+  char *text = xmalloc (len);
+  char *p = text;
+
+  if (!prepared)
+    {
+      p += sprintf (p, preamble, amk_goal_dir, amk_goal_dir);
+      prepared = 1;
+    }
+  sprintf (p, shape, name, name, amk_goal_dir, name, amk_goal_dir, name, deps, name, engine, program);
+  free (deps);
+  return text;
+}
