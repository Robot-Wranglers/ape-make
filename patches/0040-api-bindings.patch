 struct amk_sink amk_sink_stderr = { amk_stderr_write };

+/* The engine whose persistent call is running, so a function registered during it is credited to that engine.  */
+static const char *amk_binding_engine;
+
+/* A name appended once to an engine's ledger of what it gave make, its fxns or its vars.  */
+static void
+amk_binding_add (const char *engine, const char *kind, const char *name, size_t len)
+{
+  char var[96];
+  struct variable *v;
+  const char *old, *p, *w;
+  size_t wlen;
+  char *val;
+
+  snprintf (var, sizeof var, "%s.__%s__", engine, kind);
+  v = lookup_variable (var, strlen (var));
+  old = v != NULL ? v->value : "";
+  p = old;
+  while ((w = find_next_token (&p, &wlen)) != NULL)
+    if (wlen == len && memcmp (w, name, len) == 0)
+      return;
+  val = xmalloc (strlen (old) + len + 2);
+  sprintf (val, "%s%s%.*s", old, *old ? " " : "", (int) len, name);
+  define_variable_global (var, strlen (var), val, o_file, 0, NILF);
+  free (val);
+}
+
+/* $(amk.fxns? engines) and $(amk.vars? engines): what each named engine gave make, its functions or its variables, in order.  */
+static char *
+func_bindings (char *o, char **argv, const char *funcname)
+{
+  const char *kind = strstr (funcname, "fxns") != NULL ? "fxns" : "vars";
+  const char *p = argv[0], *w;
+  size_t wlen;
+  int first = 1;
+
+  while ((w = find_next_token (&p, &wlen)) != NULL)
+    {
+      char var[96];
+      struct variable *v;
+
+      snprintf (var, sizeof var, "%.*s.__%s__", (int) wlen, w, kind);
+      v = lookup_variable (var, strlen (var));
+      if (v != NULL && *v->value != '\0')
+        {
+          if (!first)
+            o = variable_buffer_output (o, " ", 1);
+          o = variable_buffer_output (o, v->value, strlen (v->value));
+          first = 0;
+        }
+    }
+  return o;
+}
+
 /* $(name.exec program[,input]): the row's persist entry in this process, no fork, so what one call leaves in the engine's state the next call finds. */
 static char *
 func_persistent (char *o, char **argv, const char *funcname)
 {
   const struct amk_engine *e = amk_engine_by_name (funcname);
   struct amk_expand_sink sink;
   char *av[4];
   size_t start = o - variable_buffer;
   int ac = 2;
   int rc;

   av[0] = (char *) e->name;
   av[1] = argv[0];
   if (strchr (funcname, '.'))
     av[0] = (char *) funcname;
   if (argv[1] != NULL)
     av[ac++] = argv[1];
   av[ac] = NULL;

   sink.base.write = amk_expand_write;
   sink.o = o;
-  rc = e->persist (&sink.base, ac, av);
+  {
+    const char *outer = amk_binding_engine;
+    amk_binding_engine = e->name;
+    rc = e->persist (&sink.base, ac, av);
+    amk_binding_engine = outer;
+  }
   shell_completed (rc, 0);
   o = sink.o;

   /* One trailing newline goes, as for every builtin; the buffer may have moved, so the start is an offset.  */
   if ((size_t) (o - variable_buffer) > start && o[-1] == '\n')
     {
       --o;
       if ((size_t) (o - variable_buffer) > start && o[-1] == '\r')
         --o;
     }
+
+  /* An import's names that are not functions are the variables it gave make.  */
+  if (strlen (funcname) > 7 && strcmp (funcname + strlen (funcname) - 7, ".import") == 0)
+    {
+      char *names = xstrndup (variable_buffer + start, o - variable_buffer - start);
+      const char *p = names, *w;
+      size_t wlen;
+
+      while ((w = find_next_token (&p, &wlen)) != NULL)
+        {
+          char *name = xstrndup (w, wlen);
+          if (!amk_function_exists (name))
+            amk_binding_add (e->name, "vars", w, wlen);
+          free (name);
+        }
+      free (names);
+    }
   return o;
 }

