Hooks: make announces three events, the goal list once it is known and each recipe's
start and end, to every engine row with a hook entry. The event vocabulary and its info
struct are make's, in amk.h; a guest hears an event as its name and the info fields, so
no guest needs a header of make's. Every event fires in the make process, where a
persistent state lives, and a hook observes: it cannot veto or replace a recipe. Lua takes
the entry and routes an event to amk.on.<event> in its persistent state.

--- a/src/amk.h
+++ b/src/amk.h
@@ -6,23 +6,46 @@
 #include <stdio.h>
+#include <sys/types.h>
+
+/* The events make announces, and what each carries: goals names the goal list, the recipe events name their target. */
+enum amk_event
+  {
+    AMK_EVENT_GOALS,
+    AMK_EVENT_RECIPE_START,
+    AMK_EVENT_RECIPE_END
+  };
+
+struct amk_event_info
+  {
+    const char *target;
+    const char *status;
+    int exit_code;
+    int exit_sig;
+    pid_t pid;
+  };
+
+extern const char *const amk_event_names[];
+void amk_hook_fire (enum amk_event event, const struct amk_event_info *info);

-/* persist, when a row has one, runs in this process against a state kept for its life and writes its result to the stream. */
+/* persist, when a row has one, runs in this process against a state kept for its life and writes its result to the stream; hook, when a row has one, hears every event as its name and the info fields. */
 struct amk_engine
   {
     const char *name;
     const char *aliases;
     int (*main) (int, char **);
     unsigned int dashdash:1;
     unsigned int cmdline:1;
