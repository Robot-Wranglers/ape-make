Hooks: make announces three events, the goal list once it is known and each recipe's
start and end, to every engine row with a hook entry. The event vocabulary and its info
struct are make's, in amk.h; a guest hears an event as its name and the info fields, so
no guest needs a header of make's. Every event fires in the make process, where a
persistent state lives, and a hook observes: it cannot veto or replace a recipe. Lua takes
the entry and routes an event to amk.on.<event> in its persistent state.

--- a/src/function.c
+++ b/src/function.c
@@ -2500,7 +2500,7 @@
     { "jq", "jq", jq_main, 0, 0, 1 },
 #endif
 #ifdef AMK_ENGINE_LUA
-    { "lua", 0, lua_run_main, 0, 0, 0, lua_persist_main },
+    { "lua", 0, lua_run_main, 0, 0, 0, lua_persist_main, lua_hook_main },
 #endif
 #ifdef AMK_ENGINE_S7
     { "s7", 0, s7_run_main, 0, 0, 0 },
@@ -2527,6 +2527,19 @@
     if (strlen (e->name) == n && memcmp (e->name, name, n) == 0)
       return e;
   return NULL;
+}
+
+/* One name per event, in enum order, so a guest can key its subscribers by it.  */
+const char *const amk_event_names[] = { "goals", "recipe_start", "recipe_end" };
+
+/* Every row with a hook entry hears the event, in table order.  */
+void
+amk_hook_fire (enum amk_event event, const struct amk_event_info *info)
+{
+  const struct amk_engine *e;
+  for (e = amk_engines; e->name; ++e)
+    if (e->hook)
+      e->hook (amk_event_names[event], info->target, info->status, info->exit_code, info->exit_sig, (long) info->pid);
 }
 
 /* Whether word is one of the row's multi-call names.  */
