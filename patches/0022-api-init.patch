+
+/* The init chunk for a row: the environment's, as text or as the file an @ names, else the payload's; NULL when there is none.  */
+static char *
+amk_init_chunk (const struct amk_engine *e)
+{
+  char var[64], path[64];
+  const char *env, *file = NULL;
+  char *chunk = NULL, *p;
+  FILE *f;
+  size_t len = 0, cap = 4096;
+
+  sprintf (var, "AMK_%s_INIT", e->name);
+  for (p = var + 4; *p != '_'; ++p)
+    if (*p >= 'a' && *p <= 'z')
+      *p -= 'a' - 'A';
+  env = getenv (var);
+  if (env != NULL && *env == '@')
+    file = env + 1;
+  else if (env != NULL && *env != '\0')
+    return xstrdup (env);
+  else
+    {
+      sprintf (path, "/zip/__init__.%s", e->name);
+      file = path;
+    }
+  f = fopen (file, "r");
+  if (f == NULL)
+    {
+      if (file != path)
+        OSS (error, NILF, _("%s: cannot read %s"), var, file);
+      return NULL;
+    }
+  chunk = xmalloc (cap + 1);
+  while (1)
+    {
+      len += fread (chunk + len, 1, cap - len, f);
+      if (len < cap)
+        break;
+      cap *= 2;
+      chunk = xrealloc (chunk, cap + 1);
+    }
+  chunk[len] = '\0';
+  fclose (f);
+  return chunk;
+}
+
+/* Every row with a persist entry runs its init chunk, once, with print on stderr.  */
+void
+amk_engine_init (void)
+{
+  const struct amk_engine *e;
+  for (e = amk_engines; e->name; ++e)
+    if (e->persist)
+      {
+        char *chunk = amk_init_chunk (e);
+        char *av[3];
+        if (chunk == NULL)
+          continue;
+        av[0] = (char *) e->name;
+        av[1] = chunk;
+        av[2] = NULL;
+        e->persist (stderr, 2, av);
+        free (chunk);
+      }
+}
+
