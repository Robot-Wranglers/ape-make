+/* make's own calls, each on the goals ledger; its acquire waits forever, or one second when other jobs wait on the load.  */
+unsigned int
+jobserver_setup (int slots, const char *style)
+{
+  return jobserver_setup_on (&js_goals, slots, style);
+}
+
+unsigned int
+jobserver_parse_auth (const char *auth)
+{
+  return jobserver_parse_auth_on (&js_goals, auth);
+}
+
+char *
+jobserver_get_auth ()
+{
+  return jobserver_get_auth_on (&js_goals);
+}
+
+unsigned int
+jobserver_enabled ()
+{
+  return jobserver_enabled_on (&js_goals);
+}
+
+void
+jobserver_clear ()
+{
+  jobserver_clear_on (&js_goals);
+}
+
+void
+jobserver_release (int is_fatal)
+{
+  jobserver_release_on (&js_goals, is_fatal);
+}
+
+void
+jobserver_pre_child (int recursive)
+{
+  jobserver_pre_child_on (&js_goals, recursive);
+}
+
+void
+jobserver_post_child (int recursive)
+{
+  jobserver_post_child_on (&js_goals, recursive);
+}
+
+void
+jobserver_signal ()
+{
+  jobserver_signal_on (&js_goals);
+}
+
+void
+jobserver_pre_acquire ()
+{
+  jobserver_pre_acquire_on (&js_goals);
+}
+
+unsigned int
+jobserver_acquire (int timeout)
+{
+  return jobserver_acquire_on (&js_goals, timeout ? 1000 : -1);
+}
+
+/* A ledger whose tokens are labels: its width in bytes, the token the last acquire read, and a release that writes a whole token.  */
+void
+jobserver_width_on (struct jobserver *js, unsigned int width)
+{
+  js->width = width;
+}
+
+const char *
+jobserver_token_on (void)
+{
+  return js_intake;
+}
+
+void
+jobserver_release_token_on (struct jobserver *js, int is_fatal, const char *t)
+{
+  int r;
+  EINTRLOOP (r, write (js->fds[1], t, js->width));
+  if (r != (int) js->width)
+    {
+      if (is_fatal)
+        pfatal_with_name (_("write jobserver"));
+      perror_with_name ("write", "");
+    }
+}
+
