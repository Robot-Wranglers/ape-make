+/* An imported target's job: a fork of make with no exec, so the engine runs inside the parsed image with the handle live. The child takes the program as written, its goal references replaced by their values, runs the engine's main over it, and leaves with the engine's status. A value file takes the output; a name, imported or a recipe target's, prints its kept value, and an imported name with none kept runs the program on the job's own standard output.  */
+static pid_t
+amk_engine_job (struct child *child)
+{
+  struct file *file = child->file;
+  const int fdin = child->good_stdin ? FD_STDIN : get_bad_stdin ();
+  struct variable *v;
+  char *program;
+  pid_t pid;
+  int r;
+
+  pid = fork ();
+  if (pid != 0)
+    return pid;
+
+  unblock_all_sigs ();
+  signal (SIGINT, SIG_DFL);
+  signal (SIGTERM, SIG_DFL);
+  signal (SIGHUP, SIG_DFL);
+  signal (SIGQUIT, SIG_DFL);
+  if (fdin >= 0 && fdin != FD_STDIN)
+    EINTRLOOP (r, dup2 (fdin, FD_STDIN));
+  if (child->output.syncout && child->output.err >= 0)
+    EINTRLOOP (r, dup2 (child->output.err, FD_STDERR));
+  if (child->output.syncout && child->output.out >= 0)
+    EINTRLOOP (r, dup2 (child->output.out, FD_STDOUT));
+  environ = child->environment;
+  amk_fork_settle ();
+  /* The job's own pair, so a workspace call from the engine goes up to the owner rather than into this fork's copy.  */
+  {
+    int creq, crep, creq_at, crep_at;
+    if (amk_ask_child_fds (&creq, &crep, &creq_at, &crep_at))
+      amk_ask_dispatch (creq, crep);
+  }
+
+  if (file->amk_value != NULL && !streq (file->amk_value, file->name))
+    _exit ((program = amk_goal_value (file->amk_value)) == NULL || puts (program) < 0 || fflush (stdout) != 0);
+  v = lookup_variable (file->amk_program, strlen (file->amk_program));
+  program = amk_goal_splice (file, v != NULL ? v->value : "");
+  if (file->amk_value != NULL && freopen (file->name, "w", stdout) == NULL)
+    {
+      fprintf (stderr, "amk: %s: cannot write: %s\n", file->name, strerror (errno));
+      _exit (127);
+    }
+  amk_engine_program (file->amk_engine, file->amk_flags, program);
+  amk_pool_release_all ();
+  _exit (127);
+}
