+/* $(name.persistent program[,input]): the row's persist entry in this process, no fork, so what one call leaves in the engine's state the next call finds. */
+static char *
+func_persistent (char *o, char **argv, const char *funcname)
+{
+  const struct amk_engine *e = amk_engine_by_name (funcname);
+  char *av[4];
+  char *buffer;
+  size_t len;
+  long end;
+  FILE *out;
+  int ac = 2;
+  int rc;
+
+  av[0] = (char *) e->name;
+  av[1] = argv[0];
+  if (argv[1] != NULL)
+    av[ac++] = argv[1];
+  av[ac] = NULL;
+
+  out = tmpfile ();
+  if (out == NULL)
+    OSS (fatal, NILF, _("$(%s ...): tmpfile: %s"), funcname, strerror (errno));
+  rc = e->persist (out, ac, av);
+  fflush (out);
+  end = ftell (out);
+  len = end > 0 ? (size_t) end : 0;
+  buffer = xmalloc (len + 1);
+  rewind (out);
+  if (len > 0 && fread (buffer, 1, len, out) != len)
+    OSS (fatal, NILF, _("$(%s ...): read back: %s"), funcname, strerror (errno));
+  fclose (out);
+  shell_completed (rc, 0);
+
+  if (len > 0 && buffer[len - 1] == '\n')
+    {
+      --len;
+      if (len > 0 && buffer[len - 1] == '\r')
+        --len;
+    }
+  if (len > 0)
+    o = variable_buffer_output (o, buffer, len);
+  free (buffer);
+  return o;
+}
+
 #define FT_ENTRY(_name, _min, _max, _exp, _func) \
   { { (_func) }, STRING_SIZE_TUPLE(_name), (_min), (_max), (_exp), 0, 0 }
 
