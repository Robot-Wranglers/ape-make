+  /* Unpack is settled ahead of the boot, so no distribution ever sees the flag.  */
+  if (argc >= 2)
+    {
+      const char *name = NULL, *dest = NULL, *rest[2] = { NULL, NULL };
+      int i, n = 0, force = 0;
+      for (i = 2; i < argc; ++i)
+        if (strcmp (argv[i], "--force") == 0)
+          force = 1;
+        else if (n < 2)
+          rest[n++] = argv[i];
+      if (strncmp (argv[1], "--ape-unpack=", 13) == 0)
+        {
+          name = argv[1] + 13;
+          dest = rest[0];
+        }
+      else if (strcmp (argv[1], "--ape-unpack") == 0
+               || strcmp (argv[1], "-x") == 0)
+        {
+          name = rest[0] ? rest[0] : "";
+          dest = rest[1];
+        }
+      if (name)
+        {
+          int r = amk_ape_unpack (name, dest, force);
+          /* The path is the only output, so a caller can include what it names.  */
+          if (r == MAKE_SUCCESS)
+            puts (dest && *dest ? dest : name);
+          exit (r);
+        }
+    }
 
   amk_payload_boot (argc, argv);
 
