+/* The call channel: a request pipe and a reply pipe, named to recipes as AMK_CALL and AMK_REPLY, one pair for this process's own recipes and one per spawned job, answered from the store while the process waits; a process that inherits a live pair holds no store and sends every request up it.  A tagged request is answered into a private FIFO under AMK_REPLY_DIR instead.  */
+struct amk_chan { int req; int rep; char *buf; size_t len; };
+#define AMK_OWN AMK_SPAWNED
+static struct amk_chan amk_chan[AMK_SPAWNED + 1];
+static int amk_up_req = -1, amk_up_rep = -1;
+static int amk_chld[2] = { -1, -1 };
+static char amk_reply_dir[PATH_MAX];
