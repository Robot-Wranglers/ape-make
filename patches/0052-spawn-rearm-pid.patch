-      char pid[32];
-      const char *q = aspid;
-
-      sprintf (pid, "%d", (int) getpid ());
-      while (*q != '\0') {
-        size_t n;
-
-        q += strspn (q, " \t");
-        n = strcspn (q, " \t");
-        if (n == 0)
-          break;
-        define_variable (q, n, pid, o_override, 0);
-        q += n;
-      }
-    }
+    if (aspid != 0)
+      amk_rearm_pid (aspid);
     free (rearm);
     free (aspid);
   }
@@ -6180,6 +6186,11 @@
     amk_conn = -1;
   }
   amk_child = 1;
+  {
