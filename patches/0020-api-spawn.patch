+/* Spawned goal lists: the pids still out, and the ones make's own reaping collected before they were asked for.  */
+
+#define AMK_SPAWNED 64
+
+static pid_t amk_live[AMK_SPAWNED];
+static struct { pid_t pid; int code; int sig; } amk_parked[AMK_SPAWNED];
+
+static int
+amk_live_drop (pid_t pid) {
+  unsigned int i;
+  for (i = 0; i < AMK_SPAWNED; ++i)
+    if (amk_live[i] == pid) { amk_live[i] = 0; return 1; }
+  return 0;
+}
+
+void
+amk_reap_foreign (pid_t pid, int code, int sig) {
+  unsigned int i;
+  if (!amk_live_drop (pid))
+    return;
+  for (i = 0; i < AMK_SPAWNED; ++i)
+    if (amk_parked[i].pid == 0) {
+      amk_parked[i].pid = pid;
+      amk_parked[i].code = code;
+      amk_parked[i].sig = sig;
+      return;
+    }
+}
+
+/* The words become the goal list and run, as a served request's do; the result is make's exit status.  */
+static int
+amk_run_goals (int n, char **words) {
+  int i;
+  goals = 0;
+  lastgoal = 0;
+  define_variable_cname ("MAKECMDGOALS", "", o_default, 0);
+  for (i = 0; i < n; ++i)
+    handle_non_switch_argument (words[i], o_command);
+  define_makeflags (0);
+  if (goals == 0)
+    return MAKE_SUCCESS;
+  switch (update_goal_chain (goals)) {
+  case us_none:
+  case us_success:  return MAKE_SUCCESS;
+  case us_question: return MAKE_TROUBLE;
+  case us_failed:   break;
+  }
+  return MAKE_FAILURE;
+}
+
+pid_t
+amk_spawn_goals (int n, char **words) {
+  unsigned int i;
+  pid_t pid;
+  for (i = 0; i < AMK_SPAWNED && amk_live[i] != 0; ++i)
+    ;
+  if (i == AMK_SPAWNED)
+    return -1;
+  fflush (NULL);
+  pid = fork ();
+  if (pid < 0)
+    return -1;
+  if (pid > 0) {
+    amk_live[i] = pid;
+    return pid;
+  }
+  amk_child = 1;
+  job_slots = 1;
+  jobserver_auth = NULL;
+  jobserver_clear ();
+  amk_forget_children ();
+  memset (amk_live, 0, sizeof amk_live);
+  memset (amk_parked, 0, sizeof amk_parked);
+  die (amk_run_goals (n, words));
+}
+
+/* A parked child first, then waitpid on the wanted pid, or on each live one in turn when any will do.  */
+int
+amk_wait_child (pid_t want, int block, pid_t *got, int *code, int *sig) {
+  unsigned int i;
+  for (;;) {
+    for (i = 0; i < AMK_SPAWNED; ++i)
+      if (amk_parked[i].pid != 0 && (want <= 0 || amk_parked[i].pid == want)) {
+        *got = amk_parked[i].pid;
+        *code = amk_parked[i].code;
+        *sig = amk_parked[i].sig;
+        amk_parked[i].pid = 0;
+        return 1;
+      }
+    for (i = 0; i < AMK_SPAWNED; ++i) {
+      int status;
+      pid_t pid;
+      if (amk_live[i] == 0 || (want > 0 && amk_live[i] != want))
+        continue;
+      pid = waitpid (amk_live[i], &status, (block && want > 0) ? 0 : WNOHANG);
+      if (pid < 0 && errno == EINTR)
+        continue;
+      if (pid <= 0)
+        continue;
+      amk_live_drop (pid);
+      *got = pid;
+      *code = WIFEXITED (status) ? WEXITSTATUS (status) : 0;
+      *sig = WIFSIGNALED (status) ? WTERMSIG (status) : 0;
+      return 1;
+    }
+    if (!block)
+      return 0;
+    usleep (5000);
+  }
+}
+
