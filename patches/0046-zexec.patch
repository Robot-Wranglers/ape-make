+/* Makefiles a request adds after the zygote's own, which the child reads before the freeze.  */
+#define AMK_MAXADDED 64
+static const char *amk_added[AMK_MAXADDED];
+static int amk_nadded;
+
 static int
+amk_zopts_makefiles (void) {
+  int i, n = 0;
+
+  for (i = 0; i < amk_nzopts; ++i)
+    if (amk_zopts[i][0] == '-' && amk_zopts[i][1] == 'f') ++n;
+  return n;
+}
+
+/* A makefile option in its joined form: one the zygote holds is counted, and one
+   past the zygote's own whole list is added.  Returns 0 for any other.  */
+static int
+amk_makefile_opt (const char *joined, const char *name, int *held) {
+  if (amk_zopts_has (joined)) {
+    if (amk_nadded == 0) ++*held;
+    return 1;
+  }
+  if (*held == 0 || *held != amk_zopts_makefiles () || amk_nadded == AMK_MAXADDED)
+    return 0;
+  amk_added[amk_nadded++] = name;
+  return 1;
+}
