+/* What make does once between reading the makefiles and walking a goal.  */
+static void
+amk_freeze (void) {
+  snap_deps ();
+  install_default_suffix_rules ();
+  convert_to_pattern ();
+  install_default_implicit_rules ();
+  snap_implicit_rules ();
+  build_vpath_lists ();
+}
+
+/* Read the makefiles the request added, as an include would.  A missing one
+   fails here, since the child skips the remake that would report it.  */
+static void
+amk_read_added (void) {
+  int i;
+
+  for (i = 0; i < amk_nadded; ++i) {
+    char *text = xmalloc (strlen (amk_added[i]) + 9);
+
+    if (access (amk_added[i], R_OK) != 0) {
+      perror_with_name ("", amk_added[i]);
+      OS (fatal, NILF, _("No rule to make target '%s'"), amk_added[i]);
+    }
+    sprintf (text, "include %s", amk_added[i]);
+    eval_buffer (text, NILF);
+    free (text);
+  }
+}
+
+/* Park before the freeze.  A probe runs the freeze and the remake in a fork;
+   when it remade a makefile the zygote starts over, else it serves.  */
+static void
+amk_park (struct goaldep *deps, unsigned int restarts) {
+  extern char **environ;
+  int status = 0;
+  pid_t probe;
+
+  fflush (NULL);
+  probe = fork ();
+  if (probe < 0)
+    pfatal_with_name ("fork");
+  if (probe == 0) {
+    amk_probe = 1;
+    return;
+  }
+
+  while (waitpid (probe, &status, 0) < 0 && errno == EINTR)
+    ;
+
+  if (WIFEXITED (status) && WEXITSTATUS (status) == MAKE_SUCCESS)
+    amk_serve (amk_serve_path, deps);
+
+  if (WIFEXITED (status) && WEXITSTATUS (status) == AMK_RESTART) {
+    char **nargv = xmalloc (((size_t) amk_serve_argc + 3) * sizeof *nargv);
+    char count[32];
+    int i, n = 0;
+
+    sprintf (count, "%u", restarts + 1);
+    setenv ("MAKE_RESTARTS", count, 1);
+    nargv[n++] = amk_serve_argv[0];
+    nargv[n++] = (char *) "--serve";
+    nargv[n++] = (char *) amk_serve_path;
+    for (i = 1; i < amk_serve_argc; ++i)
+      nargv[n++] = amk_serve_argv[i];
+    nargv[n] = 0;
+    exec_command (nargv, environ);
+  }
+
+  _exit (WIFEXITED (status) ? WEXITSTATUS (status) : MAKE_FAILURE);
+}
