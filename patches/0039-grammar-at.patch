+/* The rules behind an imported target: the value file and the phony target of the name, entered as rules, never the default goal.  */
+void
+amk_import_target (const char *name, const char *engine, const char *body,
+                   const floc *flocp)
+{
+  int no_goal_yet = default_goal_var->value[0] == '\0';
+  char *text = amk_cell_text (name, engine, body);
+
+  eval_buffer (text, flocp);
+  free (text);
+  if (no_goal_yet)
+    define_variable_global (".DEFAULT_GOAL", 13, "", o_file, 0, NILF);
+}

