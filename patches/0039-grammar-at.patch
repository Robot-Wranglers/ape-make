+/* $(name.import.target target,program): the program stored as the variable target, and the rules that run it into a cached value and print it under the target's name.  */
+static char *
+func_import_target (char *o, char **argv, const char *funcname)
+{
+  const struct amk_engine *e = amk_engine_by_name (funcname);
+  char *name = argv[0];
+  char *end = name + strlen (name);
+  const char *body = argv[1] != NULL ? argv[1] : "";
+
+  while (ISSPACE (*name))
+    name++;
+  while (end > name && ISSPACE (end[-1]))
+    *--end = '\0';
+  if (*name == '\0')
+    OS (fatal, reading_file, _("%s: no target named"), funcname);
+  define_variable_global (name, strlen (name), body, o_file, 1, reading_file);
+  amk_import_target (name, e->name, body, reading_file);
+  return o;
+}

