+/* The store's backing declaration, a mode word then a path, on a row made on first use; a second declaration must repeat the first.  */
+int
+amk_store_backing (const char *ns, const char *spec)
+{
+  const struct amk_engine *e = amk_engine_by_name (AMK_STORE_ENGINE);
+  const struct amk_engine *owner;
+  struct amk_ns *row;
+  char *copy, *word, *path;
+  int mode;
+
+  if (e == NULL || e->run == NULL)
+    {
+      fprintf (stderr, "amk: store: this build has no %s store\n", AMK_STORE_ENGINE);
+      return 2;
+    }
+  if (!amk_ns_valid (ns))
+    {
+      fprintf (stderr, "amk: store: namespace \"%s\" is not a name\n", ns);
+      return 2;
+    }
+  owner = amk_ns_owner (ns);
+  if (owner != NULL && owner != e)
+    {
+      fprintf (stderr, "amk: store: namespace %s belongs to %s\n", ns, owner->name);
+      return 2;
+    }
+  copy = xstrdup (spec);
+  word = strtok (copy, " \t");
+  path = word != NULL ? strtok (NULL, " \t") : NULL;
+  for (mode = AMK_BACK_RUN; mode <= AMK_BACK_SHARED; ++mode)
+    if (word != NULL && streq (word, amk_back_names[mode]))
+      break;
+  if (word == NULL || mode > AMK_BACK_SHARED || (mode >= AMK_BACK_OWNED && path == NULL)
+      || (path != NULL && strtok (NULL, " \t") != NULL))
+    {
+      fprintf (stderr, "amk: store: %s: expected a backing, one of run, owned PATH, shared PATH; got: %s\n", ns, spec);
+      free (copy);
+      return 2;
+    }
+  row = amk_ns_find (e, ns);
+  if (row == NULL)
+    row = amk_ns_add (e, ns);
+  if (row->mode != AMK_BACK_NONE)
+    {
+      int same = row->mode == mode && ((row->path == NULL && path == NULL)
+                                       || (row->path != NULL && path != NULL && streq (row->path, path)));
+      free (copy);
+      if (same)
+        return 0;
+      fprintf (stderr, "amk: store: %s is backed as %s%s%s already\n", ns, amk_back_names[row->mode],
+               row->path != NULL ? " " : "", row->path != NULL ? row->path : "");
+      return 2;
+    }
+  row->mode = mode;
+  row->path = path != NULL ? xstrdup (path) : NULL;
+  free (copy);
+  return 0;
 }

