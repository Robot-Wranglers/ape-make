Spawn stdout: a spawned job may write its standard output to a file instead of the
parent's stream, so a caller can read what a goal printed once the job is collected. The
path is opened in the child before its goals run; a path that cannot be opened is
reported there and the job keeps the parent's stream. Lua exposes it as opts.stdout.

--- a/src/main.c
+++ b/src/main.c
@@ -5479,7 +5479,7 @@
 }
 
 pid_t
-amk_spawn_goals (int n, char **words, int foreground) {
+amk_spawn_goals (int n, char **words, int foreground, const char *stdout_path) {
   unsigned int i;
   pid_t pid;
   for (i = 0; i < AMK_SPAWNED && amk_live[i] != 0; ++i)
@@ -5500,6 +5500,8 @@
   setpgid (0, 0);
   if (foreground)
     amk_tty_give (getpid ());
+  if (stdout_path != NULL && freopen (stdout_path, "w", stdout) == NULL)
+    fprintf (stderr, "amk: spawn: cannot write %s: %s\n", stdout_path, strerror (errno));
   signal (SIGINT, fatal_error_signal);
   signal (SIGTERM, fatal_error_signal);
   signal (SIGHUP, fatal_error_signal);
