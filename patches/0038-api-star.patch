Star forms: every engine builtin but an argv form gets a twin whose name ends in a star,
taking the name of a variable where the base takes program text. $(micropy.import* body)
is $(micropy.import ...) handed body's unexpanded value, dedented; a second argument
passes through as the input. The star joins the characters a function name may hold,
so make looks the twin up as a builtin; an undefined name or an inconsistent indent is
fatal, since the text is always a program. $(amk.dedent* name) is amk.val.dedent under
the same rule.

--- a/src/main.c
+++ b/src/main.c
@@ -727,4 +727,5 @@
   stopchar_map[(int)'-'] = MAP_USERFUNC;
   stopchar_map[(int)'_'] = MAP_USERFUNC;
+  stopchar_map[(int)'*'] |= MAP_USERFUNC;

   stopchar_map[(int)' '] = MAP_BLANK;
--- a/src/function.c
+++ b/src/function.c
@@ -2880,4 +2880,36 @@
   return o;
 }
+
+/* A star builtin: the builtin named without the star, handed the dedented unexpanded value of the variable the first argument names.  */
+static char *
+func_star (char *o, char **argv, const char *funcname)
+{
+  char *base = xstrndup (funcname, strlen (funcname) - 1);
+  const struct function_table_entry *f = lookup_function (base);
+  char *name = argv[0];
+  char *end = name + strlen (name);
+  struct variable *v;
+  char *text, *args[3];
+  size_t width;
+  int bad;
+
+  while (ISSPACE (*name))
+    name++;
+  while (end > name && ISSPACE (end[-1]))
+    *--end = '\0';
+  v = lookup_variable (name, strlen (name));
+  if (v == NULL)
+    OSS (fatal, reading_file, _("%s: no variable named '%s'"), funcname, name);
+  text = amk_dedent (v->value, &width, &bad);
+  if (bad)
+    fatal (reading_file, strlen (funcname) + strlen (name) + INTSTR_LENGTH, _("%s %s: inconsistent indentation (a line is less-indented than the %d-column body base)"), funcname, name, (int) width);
+  args[0] = text;
+  args[1] = argv[1];
+  args[2] = NULL;
+  o = f->fptr.func_ptr (o, args, f->name);
+  free (text);
+  free (base);
+  return o;
+}

