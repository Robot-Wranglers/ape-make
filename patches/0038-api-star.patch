Star forms: every engine builtin but an argv form gets a twin whose name ends in a star,
where any argument may name a variable. An argument that names a defined variable is
replaced by its unexpanded value, and any other is literal text: $(micropy.import* body)
is $(micropy.import ...) handed body's value, and $(lua* prog,data) hands over both. The
program's value is dedented and an inconsistent indent is fatal; the input passes as it
is. With no argument naming a variable the twin is the base builtin. The star joins the
characters a function name may hold, so make looks the twin up as a builtin.
$(amk.dedent* name) is amk.val.dedent.

--- a/src/main.c
+++ b/src/main.c
@@ -727,4 +727,5 @@
   stopchar_map[(int)'-'] = MAP_USERFUNC;
   stopchar_map[(int)'_'] = MAP_USERFUNC;
+  stopchar_map[(int)'*'] |= MAP_USERFUNC;

   stopchar_map[(int)' '] = MAP_BLANK;
--- a/src/function.c
+++ b/src/function.c
@@ -2880,4 +2880,47 @@
   return o;
 }
+
+/* The variable an argument names once its surrounding blanks are trimmed, or null when none of that name is defined.  */
+static struct variable *
+star_lookup (const char *arg)
+{
+  const char *end = arg + strlen (arg);
+
+  while (ISSPACE (*arg))
+    arg++;
+  while (end > arg && ISSPACE (end[-1]))
+    end--;
+  return end > arg ? lookup_variable (arg, end - arg) : NULL;
+}
+
+/* A star builtin: the builtin named without the star, each argument that names a defined variable replaced by its unexpanded value, the program's dedented.  */
+static char *
+func_star (char *o, char **argv, const char *funcname)
+{
+  char *base = xstrndup (funcname, strlen (funcname) - 1);
+  const struct function_table_entry *f = lookup_function (base);
+  struct variable *prog = star_lookup (argv[0]);
+  struct variable *input = argv[1] != NULL ? star_lookup (argv[1]) : NULL;
+  char *text = NULL, *data = NULL, *args[3];
+  size_t width;
+  int bad;
+
+  if (prog != NULL)
+    {
+      text = amk_dedent (prog->value, &width, &bad);
+      if (bad)
+        fatal (reading_file, strlen (funcname) + strlen (prog->name) + INTSTR_LENGTH, _("%s %s: inconsistent indentation (a line is less-indented than the %d-column body base)"), funcname, prog->name, (int) width);
+    }
+  if (input != NULL)
+    data = xstrdup (input->value);
+  args[0] = text != NULL ? text : argv[0];
+  args[1] = data != NULL ? data : argv[1];
+  args[2] = NULL;
+  o = f->fptr.func_ptr (o, args, f->name);
+  free (data);
+  free (text);
+  free (base);
+  return o;
+}

