+/* An imported target's job, inside its fork: the engine's main over the program as the builtin would pass it, jq with the null input it needs to run without data; handle writes have no queue, so they end with the job.  */
+void
+amk_engine_program (const struct amk_engine *e, const char *program)
+{
+  char *av[64];
+  char *args = NULL;
+  int ac = 1;
+  av[0] = (char *) e->name;
+  if (strcmp (e->name, "jq") == 0)
+    av[ac++] = (char *) "-n";
+  if (e->dashdash)
+    av[ac++] = (char *) "--";
+  if (e->cmdline)
+    {
+      args = xstrdup (program);
+      ac += amk_split_argv (args, av + ac, 62 - ac);
+    }
+  else
+    av[ac++] = (char *) program;
+  av[ac] = NULL;
+  amk_queue_fd = -1;
+  optind = 0;
+  amk_exit (e->main (ac, av));
+}
+
 /* The expansion being built, as a sink: what an engine writes lands in make's own buffer at the call's place, with no copy between.  */
