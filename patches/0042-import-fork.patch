+/* An imported target's job: a fork of make with no exec, so the engine runs inside the parsed image with the handle live. The child expands the program for its target, runs the engine's main over it with standard output on the value file, and leaves with the engine's status.  */
+static pid_t
+amk_engine_job (struct child *child)
+{
+  struct file *file = child->file;
+  const int fdin = child->good_stdin ? FD_STDIN : get_bad_stdin ();
+  char *ref, *program;
+  pid_t pid;
+  int r;
+
+  pid = fork ();
+  if (pid != 0)
+    return pid;
+
+  unblock_all_sigs ();
+  signal (SIGINT, SIG_DFL);
+  signal (SIGTERM, SIG_DFL);
+  signal (SIGHUP, SIG_DFL);
+  signal (SIGQUIT, SIG_DFL);
+  if (fdin >= 0 && fdin != FD_STDIN)
+    EINTRLOOP (r, dup2 (fdin, FD_STDIN));
+  if (child->output.syncout && child->output.err >= 0)
+    EINTRLOOP (r, dup2 (child->output.err, FD_STDERR));
+  environ = child->environment;
+  amk_fork_settle ();
+
+  ref = xmalloc (strlen (file->amk_program) + 4);
+  sprintf (ref, "${%s}", file->amk_program);
+  program = allocated_variable_expand_for_file (ref, file);
+  if (freopen (file->name, "w", stdout) == NULL)
+    {
+      fprintf (stderr, "amk: %s: cannot write: %s\n", file->name, strerror (errno));
+      _exit (127);
+    }
+  amk_engine_program (file->amk_engine, program);
+  _exit (127);
 }

