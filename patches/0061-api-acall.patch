+/* The deferred calls in flight: the pid, the pipe its result arrives on, and the queue its writes come back through.  */
+static struct { pid_t pid; int fd; FILE *queue; } amk_calls[AMK_SPAWNED];
+
+/* A forked call holds no socket, so a server's connection closes with its reply rather than when the call ends.  */
+static void
+amk_close_sockets (void) {
+  int fd, top = (int) sysconf (_SC_OPEN_MAX);
+  struct stat st;
+  if (top < 0 || top > 4096) top = 4096;
+  for (fd = 3; fd < top; ++fd)
+    if (fstat (fd, &st) == 0 && S_ISSOCK (st.st_mode))
+      close (fd);
+}
