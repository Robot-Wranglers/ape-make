#!/usr/bin/env -S amk -j4 -f

# via/amk/demos/tuple-space.amk: a tuple space over a sqlite workspace, with workers in four languages taking candidates under -j through one atomic pattern match.

$(amk.require sqlite awk lua micropy js)

# The schema is the space: the tuples, the answer of the last verb, and the verbs as views whose insert triggers do the work; a pattern is an array where _ matches anything, and inp takes rd's first match.
@sqlite.import
define tuplespace
  CREATE TABLE ts(t TEXT);
  CREATE TABLE answer(t TEXT);
  CREATE VIEW out(p) AS SELECT NULL;
  CREATE VIEW rd(p) AS SELECT NULL;
  CREATE VIEW inp(p) AS SELECT NULL;
  CREATE TRIGGER out INSTEAD OF INSERT ON out BEGIN
    DELETE FROM answer;
    INSERT INTO ts VALUES(json(NEW.p));
  END;
  CREATE TRIGGER rd INSTEAD OF INSERT ON rd BEGIN
    DELETE FROM answer;
    INSERT INTO answer SELECT t FROM ts WHERE json_array_length(t) = json_array_length(NEW.p)
      AND NOT EXISTS (SELECT 1 FROM json_each(NEW.p) AS p, json_each(t) AS v WHERE p.key = v.key AND p.value IS NOT '_' AND p.value IS NOT v.value)
      ORDER BY rowid;
  END;
  CREATE TRIGGER inp INSTEAD OF INSERT ON inp BEGIN
    INSERT INTO rd VALUES(NEW.p);
    DELETE FROM answer WHERE rowid > (SELECT min(rowid) FROM answer);
    DELETE FROM ts WHERE rowid = (SELECT min(rowid) FROM ts WHERE t = (SELECT t FROM answer));
  END;
endef

# Every verb is the same request: insert the pattern into the verb, read the answer; once as a make macro for an engine's amk.call, once as a shell function for a recipe.
ts.sql = INSERT INTO $(1) VALUES(:p); SELECT json(t) AS t FROM answer
ts = $(tuplespace.update --arg p '$(2)' $(call ts.sql,$(1)))
ts.sh = source amk.sh ; ts() { amk.ns update tuplespace --arg p "$$2" -- "$(call ts.sql,$$1)" ; }

N ?= 60

__main__: report

# The master outs one candidate per number; the workers run at once; the report reads what they left.
candidates:
	@${ts.sh} ; for n in $$(seq 2 ${N}); do ts out "[\"candidate\",$$n]" ; done

workers: awk.worker lua.loop micropy.loop js.loop
awk.worker lua.loop micropy.loop js.loop: candidates

report: workers
	@${ts.sh} ; printf 'primes: ' ; ts rd '["prime","_","_"]' | jq.pipe -r '.t[1]' | sort -n | tr '\n' ' ' ; echo
	@${ts.sh} ; amk.ns get tuplespace -- "SELECT t ->> 2 AS who, count(*) AS n FROM ts WHERE t ->> 0 = 'prime' GROUP BY who ORDER BY who"
	@${ts.sh} ; printf 'left: ' ; ts rd '["candidate","_"]' | wc -l | tr -d ' '

# The awk worker is a shell loop: a take, the verdict from awk as a tool in the pipe, an out when it is prime.
awk.worker:
	@${ts.sh} ; while t=$$(ts inp '["candidate","_"]') && [ -n "$$t" ]; do \
	  n=$$(printf '%s' "$$t" | jq.pipe '.t[1]') ; \
	  if [ "$$(printf '%s' "$$n" | awk '${awk.prime}')" = prime ] ; then ts out "[\"prime\",$$n,\"awk\"]" ; fi ; done

define awk.prime
  { n = $$1 + 0; p = n > 1; for (d = 2; d * d <= n; d++) if (n % d == 0) p = 0; print (p ? "prime" : "composite") }
endef

# The engine workers are imported targets that take and out through amk.call, with no shell at all.
@lua.import.target
define lua.loop
  local json = require("dkjson")
  local function prime(n) if n < 2 then return false end for d = 2, math.floor(math.sqrt(n)) do if n % d == 0 then return false end end return true end
  while true do
    local t = amk.call("ts", "inp", '["candidate","_"]')
    if t == "" then break end
    local n = json.decode(t).t[2]
    if prime(n) then amk.call("ts", "out", '["prime",' .. n .. ',"lua"]') end
  end
endef

@micropy.import.target
define micropy.loop
  import json, amk
  def prime(n):
      return n > 1 and all(n % d for d in range(2, int(n ** 0.5) + 1))
  while True:
      t = amk.call("ts", "inp", '["candidate","_"]')
      if not t:
          break
      n = json.loads(t)["t"][1]
      if prime(n):
          amk.call("ts", "out", '["prime",%d,"micropy"]' % n)
endef

@js.import.target
define js.loop
  const prime = n => { if (n < 2) return false; for (let d = 2; d * d <= n; d++) if (n % d === 0) return false; return true; };
  for (;;) {
    const t = amk.call("ts", "inp", '["candidate","_"]');
    if (t === "") break;
    const n = JSON.parse(t).t[1];
    if (prime(n)) amk.call("ts", "out", '["prime",' + n + ',"js"]');
  }
endef
