#!/usr/bin/env -S amk --silent -f
#
# demos/wasm-wat.amk:
#  wasm text from the standard library: the module registers the engine,
#  so a module written as text assembles in a container and its export is
#  called as a make function.
#

load wat

# A source define goes out raw, so the dollar names here are wat's, not make's.
@wat.import
define fib.wat
  (module
    (func (export "fib") (param $n i32) (result i32)
      (local $a i32) (local $b i32) (local $t i32)
      (local.set $b (i32.const 1))
      (block $done
        (loop $next
          (br_if $done (i32.eqz (local.get $n)))
          (local.set $t (i32.add (local.get $a) (local.get $b)))
          (local.set $a (local.get $b))
          (local.set $b (local.get $t))
          (local.set $n (i32.sub (local.get $n) (i32.const 1)))
          (br $next)))
      (local.get $a)))
endef

results := $(fib 10) $(fib 20) $(fib 30)

__main__:
	echo "fib 10 20 30: $(results)"
	test "$(lastword $(results))" = 832040
