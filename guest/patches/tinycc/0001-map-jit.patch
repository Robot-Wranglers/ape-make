Run memory on macOS arm64: the kernel refuses an mprotect to executable on
plain pages, and a MAP_JIT mapping is writable or executable per thread,
never both. Under cosmopolitan the run memory there is two mappings at a
fixed distance, as the selinux layout has them: a MAP_JIT half for code and
a plain half for data. Relocation writes both into the plain half, then the
code is copied into the jit half with the thread's write protection off,
and the instruction cache invalidated.

--- a/tccrun.c
+++ b/tccrun.c
@@ -113,10 +113,37 @@
 # define CONFIG_RUNMEM_VIRTUALALLOC 1
 #endif

+#ifdef __COSMOPOLITAN__
+#include <libc/dce.h>
+#include <libc/runtime/syslib.internal.h>
+#define rt_jit() IsXnuSilicon()
+static void rt_jit_write(int on)
+{
+    if (rt_jit())
+        __syslib->__pthread_jit_write_protect_np(!on);
+}
+#else
+#define rt_jit() 0
+#define rt_jit_write(on)
+#endif
+
 static int rt_mem(TCCState *s1, int size)
 {
     void *ptr;
     int ptr_diff = 0;
+#ifdef __COSMOPOLITAN__
+    if (rt_jit()) {
+        ptr = mmap(NULL, size * 2, PROT_READ|PROT_WRITE|PROT_EXEC,
+                   MAP_PRIVATE|MAP_ANONYMOUS|MAP_JIT, -1, 0);
+        if (ptr == MAP_FAILED
+            || mmap((char *)ptr + size, size, PROT_READ|PROT_WRITE,
+                    MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED, -1, 0) == MAP_FAILED)
+            return tcc_error_noabort("tccrun: could not map jit memory");
+        s1->run_ptr = ptr;
+        s1->run_size = size * 2;
+        return size;
+    }
+#endif
 #ifdef CONFIG_SELINUX
     /* Using mmap instead of malloc */
     void *prw;
@@ -168,6 +195,14 @@
     if (ptr_diff < 0)
         return -1;
     ret = tcc_relocate_ex(s1, s1->run_ptr, ptr_diff);
+#ifdef __COSMOPOLITAN__
+    if (rt_jit() && ret == 0) {
+        rt_jit_write(1);
+        memcpy(s1->run_ptr, (char *)s1->run_ptr + ptr_diff, ptr_diff);
+        rt_jit_write(0);
+        __syslib->__sys_icache_invalidate(s1->run_ptr, ptr_diff);
+    }
+#endif
     if (ret == 0)
         st_link(s1);
     return ret;
@@ -198,6 +233,10 @@
     win64_del_function_table(s1->run_function_table);
 #endif
     size = s1->run_size;
+    if (rt_jit()) {
+        munmap(ptr, size);
+        return;
+    }
 #ifdef CONFIG_SELINUX
     munmap(ptr, size);
 #elif CONFIG_RUNMEM_VIRTUALALLOC
@@ -481,6 +520,8 @@
     if (!VirtualProtect(ptr, length, protect[mode], &old))
         return -1;
 #else
+    if (rt_jit())
+        return 0;
     static const unsigned char protect[] = {
         PROT_READ | PROT_EXEC,
         PROT_READ,
